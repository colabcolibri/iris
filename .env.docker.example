# Docker Compose. Copie para .env.docker e troque cada change-me.
# O Compose lê este arquivo. O pnpm dev não lê.
# O que cada nome faz está em iris-app/.env.example. Aqui só entra o que muda no container.

# -----------------------------------------------------------------------------
# Só o Compose — o processo Iris ignora
# -----------------------------------------------------------------------------
# IRIS_HOST_PORT=8792
# MAILPIT_UI_PORT=8025

# -----------------------------------------------------------------------------
# Processo — o Dockerfile já define NODE_ENV, HOST, PORT e IRIS_DB_PATH
# -----------------------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=8792
# Volume iris-data montado em /app/data (control.db, tenants/, media/, iris.db).
IRIS_DB_PATH=/app/data/iris.db

# -----------------------------------------------------------------------------
# Login
# allowlist = só IRIS_ADMIN_EMAIL abre conta. Liste outros em IRIS_ALLOWED_EMAILS.
# open = qualquer email confirmado. closed = não abre conta nova.
# -----------------------------------------------------------------------------
IRIS_ADMIN_EMAIL=you@example.com
IRIS_SESSION_SECRET=change-me-session-secret-min-32-chars
IRIS_OTP_PEPPER=change-me-otp-pepper-min-32-chars
IRIS_TENANT_SIGNUP=allowlist
# IRIS_ALLOWED_EMAILS=you@example.com,other@example.com

# -----------------------------------------------------------------------------
# E-mail — Mailpit na rede do Compose. Host público: troque por resend.
# -----------------------------------------------------------------------------
IRIS_EMAIL_PROVIDER=smtp
IRIS_SMTP_HOST=mailpit
IRIS_SMTP_PORT=1025
IRIS_FROM_EMAIL=Iris <noreply@localhost>
# IRIS_EMAIL_PROVIDER=resend
# IRIS_FROM_EMAIL=you@example.com
# RESEND_API_KEY=re_...
# IRIS_CONTACT_EMAIL=contact@example.com

# -----------------------------------------------------------------------------
# Criptografia e URL
# -----------------------------------------------------------------------------
IRIS_TOKEN_ENCRYPTION_KEY=change-me-token-encryption-key-64-hex-or-passphrase
IRIS_PUBLIC_BASE_URL=http://localhost:8792
IRIS_PUBLISH_URL_SECRET=change-me-publish-secret

# -----------------------------------------------------------------------------
# Meta / Instagram — guia: iris-app/docs/configuracao/README.md
# -----------------------------------------------------------------------------
# META_INSTAGRAM_APP_ID=
# META_INSTAGRAM_APP_SECRET=
# META_APP_ID=
# META_APP_SECRET=
# META_OAUTH_REDIRECT_URI=http://localhost:8792/auth/meta/callback
# META_WEBHOOK_VERIFY_TOKEN=
# META_GRAPH_API_VERSION=v21.0
# META_PAGE_ID=
# META_PAGE_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Agente e MCP
# A chave do modelo fica na conta, em Configurações. Não use LLM_API_KEY aqui.
# -----------------------------------------------------------------------------
IRIS_AGENT_TOKEN=change-me-agent
IRIS_MCP_CONNECTION_CODE=change-me-mcp-connection
