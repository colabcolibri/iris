# Env do container. Crie assim, na raiz do repositório:
#   cp .env.docker.example .env.docker
# Troque cada change-me e o IRIS_ADMIN_EMAIL.
#
# O docker-compose.yml injeta .env.docker no processo (env_file).
# O pnpm dev não lê este arquivo. Ele lê iris-app/.env.
# Um painel de host recebe estas mesmas linhas. Não há outra lista.
#
# A porta publicada no host (8792 e 8025) não fica aqui. O Compose interpola
# IRIS_HOST_PORT e MAILPIT_UI_PORT a partir de um arquivo chamado .env
# na raiz, ou do shell. O env_file não entra nessa interpolação.
#
# Umami (VITE_UMAMI_*) entra no JavaScript na hora do build, não neste arquivo.

# -----------------------------------------------------------------------------
# Processo — o Dockerfile já define NODE_ENV, HOST, PORT e IRIS_DB_PATH.
# Repetir aqui deixa o arquivo explícito para colar num painel.
# -----------------------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=8792
# Volume iris-data montado em /app/data (control.db, tenants/, media/, iris.db).
IRIS_DB_PATH=/app/data/iris.db

# -----------------------------------------------------------------------------
# Login
# allowlist = só IRIS_ADMIN_EMAIL abre conta. Liste outros em IRIS_ALLOWED_EMAILS.
# open = qualquer email confirmado. closed = não abre conta nova.
# -----------------------------------------------------------------------------
IRIS_ADMIN_EMAIL=you@example.com
IRIS_SESSION_SECRET=change-me-session-secret-min-32-chars
IRIS_OTP_PEPPER=change-me-otp-pepper-min-32-chars
IRIS_TENANT_SIGNUP=allowlist
# IRIS_ALLOWED_EMAILS=you@example.com,other@example.com

# -----------------------------------------------------------------------------
# E-mail — Mailpit na rede do Compose. Host público: troque por resend.
# -----------------------------------------------------------------------------
IRIS_EMAIL_PROVIDER=smtp
IRIS_SMTP_HOST=mailpit
IRIS_SMTP_PORT=1025
IRIS_FROM_EMAIL=Iris <noreply@localhost>
# IRIS_EMAIL_PROVIDER=resend
# IRIS_FROM_EMAIL=you@example.com
# RESEND_API_KEY=re_...
# IRIS_CONTACT_EMAIL=contact@example.com

# -----------------------------------------------------------------------------
# Criptografia e URL
# -----------------------------------------------------------------------------
IRIS_TOKEN_ENCRYPTION_KEY=change-me-token-encryption-key-64-hex-or-passphrase
IRIS_PUBLIC_BASE_URL=http://localhost:8792
IRIS_PUBLISH_URL_SECRET=change-me-publish-secret

# -----------------------------------------------------------------------------
# Meta / Instagram — guia: iris-app/docs/configuracao/README.md
# -----------------------------------------------------------------------------
# META_INSTAGRAM_APP_ID=
# META_INSTAGRAM_APP_SECRET=
# META_APP_ID=
# META_APP_SECRET=
# META_OAUTH_REDIRECT_URI=http://localhost:8792/auth/meta/callback
# META_WEBHOOK_VERIFY_TOKEN=
# META_GRAPH_API_VERSION=v21.0
# META_PAGE_ID=
# META_PAGE_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Agente e MCP
# A chave do modelo fica na conta, em Configurações. Não use LLM_API_KEY aqui.
# -----------------------------------------------------------------------------
IRIS_AGENT_TOKEN=change-me-agent
IRIS_MCP_CONNECTION_CODE=change-me-mcp-connection

# -----------------------------------------------------------------------------
# Ajustes opcionais — o código já tem estes defaults. Descomente para mudar.
# -----------------------------------------------------------------------------
# IRIS_REPLY_MAX_CONCURRENT=10
# IRIS_RETENTION_DAYS=90
# IRIS_RETENTION_TICK_MS=86400000
# IRIS_PUBLISH_TICK_MS=60000
# IRIS_UPLOAD_MAX_BYTES=15728640
# IRIS_IMAGE_MAX_LONG_EDGE=1080
# IRIS_JPEG_QUALITY=85
# IRIS_IMAGE_MAX_BYTES=1572864
# IRIS_SESSION_MAX_AGE_SEC=86400
# IRIS_OTP_TTL_MINUTES=15
# SMTP com autenticação, quando sair do Mailpit:
# IRIS_SMTP_SECURE=true
# IRIS_SMTP_USER=
# IRIS_SMTP_PASS=
# Origens extras do CORS, além de localhost. Separadas por vírgula.
# IRIS_CORS_ORIGINS=https://seu-dominio
