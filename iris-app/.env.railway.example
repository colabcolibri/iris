# Railway / produção — copie os nomes para o painel do provedor.
# Nunca commitar valores reais (secrets, emails, domínios pessoais).

NODE_ENV=production
HOST=0.0.0.0
PORT=8792
IRIS_DB_PATH=/app/data/iris.db

# Analytics (Umami) — opcional. Só ativa com as duas variáveis no build (Vite).
# VITE_UMAMI_WEBSITE_ID=
# VITE_UMAMI_SCRIPT_URL=

IRIS_ADMIN_EMAIL=you@example.com
# Cookie HMAC do login admin (OTP). Usado em toda request da UI — não é one-shot.
# Não autentica MCP/agent; não assina URLs de mídia. Gere: openssl rand -hex 32
IRIS_SESSION_SECRET=change-me-session-secret-min-32-chars
IRIS_OTP_PEPPER=change-me-otp-pepper-min-32-chars
IRIS_TOKEN_ENCRYPTION_KEY=64-char-hex-or-passphrase

IRIS_EMAIL_PROVIDER=resend
IRIS_FROM_EMAIL=you@example.com
RESEND_API_KEY=re_...

# URL pública HTTPS deste deploy (domínio Railway / custom). Meta e curl MCP precisam alcançar.
IRIS_PUBLIC_BASE_URL=https://your-public-host
META_OAUTH_REDIRECT_URI=https://your-public-host/auth/meta/callback
# HMAC das URLs assinadas (/publish/media/… e /upload/assets/…). Distinto de SESSION_SECRET e de Bearer.
# Secret permanente no server; cada URL tem TTL (publish ~1h, upload MCP ~5min one-shot).
# Obrigatório para publicar no IG e para iris_prepare_post_asset_upload. Gere: openssl rand -hex 32
IRIS_PUBLISH_URL_SECRET=change-me-publish-secret

META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=
# DMs — ../docs/meta/06-mensagens-receptor-primario.md + 07-page-access-token.md
# META_PAGE_ID=
# META_PAGE_ACCESS_TOKEN=

# Opcional: agente / MCP / LLM (MCP também pode ser gerado na UI → Configurações)
# IRIS_AGENT_TOKEN=
# IRIS_MCP_CONNECTION_CODE=
# LLM_API_KEY=
