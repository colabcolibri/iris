{
  "name": "iris",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Iris — agendamento, publicação e comentários no Instagram (serviço independente do Casper)",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --env-file=.env --experimental-strip-types src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "build:admin": "node scripts/clean-vite-assets.mjs && pnpm --dir admin build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test $(find src test -name '*.test.ts' -print 2>/dev/null | tr '\\n' ' ')"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "nodemailer": "^7.0.5",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^6.4.17",
    "@vitejs/plugin-react": "^6.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.0"
  }
}
