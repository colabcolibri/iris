# Server
PORT=8792
HOST=0.0.0.0
# Relativo a iris-app/ (não ao cwd de server/). Absoluto também ok.
IRIS_DB_PATH=./data/iris.db

# Dev only — Vite allowedHosts (túnel ngrok/cloudflare). Não afeta produção (build estático).
# * = qualquer host. Omitir = só localhost.
VITE_ALLOWED_HOSTS=.ngrok-free.app,.ngrok.io,.trycloudflare.com

# Analytics (Umami) — opcional. Só ativa com as duas variáveis no build (Vite).
# VITE_UMAMI_WEBSITE_ID=
# VITE_UMAMI_SCRIPT_URL=

# Auth
IRIS_AGENT_TOKEN=change-me-agent
# MCP — clients de IA (Cursor, ChatGPT, Claude). Distinto de IRIS_AGENT_TOKEN.
# Generate: openssl rand -hex 32
# Dev fallback (server only): dev-mcp-connection-code-change-me — never in production
IRIS_MCP_CONNECTION_CODE=change-me-mcp-connection
# IRIS_ADMIN_TOKEN=change-me-admin  # opcional — CLI/scripts; UI usa OTP
IRIS_ADMIN_EMAIL=you@example.com
# IRIS_CONTACT_EMAIL=ola@sergioluciano.com
# Cookie HMAC do login admin (OTP). Usado em TODA request autenticada da UI — não é one-shot.
# Não autentica MCP/agent; não assina URLs de mídia. Gere: openssl rand -hex 32
IRIS_SESSION_SECRET=change-me-session-secret-min-32-chars
IRIS_OTP_PEPPER=change-me-otp-pepper-min-32-chars
# Dev: smtp + Mailpit (portas 1025 / 8025) — default quando NODE_ENV != production
# IRIS_EMAIL_PROVIDER=smtp
# IRIS_SMTP_HOST=127.0.0.1
# IRIS_SMTP_PORT=1025
# Prod: resend
# IRIS_EMAIL_PROVIDER=resend
# IRIS_FROM_EMAIL=you@example.com
# RESEND_API_KEY=re_...
# Agente: ver ../iris-agent/ (kit Meridian portável)

# LLM auto-reply (v1-S6+)
# LLM_API_KEY=
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini
# IRIS_REPLY_MAX_CONCURRENT=10
# Delay da fila de comentários: Configurações → Agente de comentários (UI), não .env
# IRIS_REPLY_TONE=amigável e profissional
# IRIS_RETENTION_DAYS=90
# IRIS_RETENTION_TICK_MS=86400000

# Meta / Instagram — Instagram Login (sem Página do Facebook)
# Cada deploy precisa do SEU app Meta (BYOA). Não commite secrets reais.
# Guia passo a passo: ../docs/meta/README.md
# Use o Instagram App ID/Secret (NÃO o App ID de Configurações → Básico):
# Dashboard → Instagram → API setup with Instagram login → Business login settings
# META_INSTAGRAM_APP_ID=
# META_INSTAGRAM_APP_SECRET=
# Legado (mesmos valores Instagram, se preferir um nome só):
# META_APP_ID=
# META_APP_SECRET=
# IRIS_UPLOAD_MAX_BYTES=15728640
# IRIS_IMAGE_MAX_LONG_EDGE=1080
# IRIS_JPEG_QUALITY=85
# IRIS_IMAGE_MAX_BYTES=1572864
# IRIS_TOKEN_ENCRYPTION_KEY=64-char-hex-or-passphrase

# Host alcançável por Meta (publish) e pelo curl do MCP (upload assinado).
# Local sem túnel: http://127.0.0.1:8792 — com ngrok/cloudflare: a URL HTTPS do túnel.
IRIS_PUBLIC_BASE_URL=http://127.0.0.1:8792
# HMAC das URLs assinadas (/publish/media/… e /upload/assets/…). Distinto de SESSION_SECRET e de Bearer.
# O secret fica no server para sempre; cada URL individual expira (~1h publish / ~5min upload) e upload é one-shot.
# Usado sempre que publica no IG ou prepara upload MCP. Gere: openssl rand -hex 32
IRIS_PUBLISH_URL_SECRET=change-me-publish-secret
# IRIS_PUBLISH_TICK_MS=60000
# META_GRAPH_API_VERSION=v21.0
# META_IG_USER_ID=
# META_APP_ID=
# META_APP_SECRET=
# META_OAUTH_REDIRECT_URI=http://127.0.0.1:8792/auth/meta/callback
# META_WEBHOOK_VERIFY_TOKEN=
# META_ACCESS_TOKEN=
# DMs — guias ../docs/meta/06-mensagens-receptor-primario.md e 07-page-access-token.md
# META_PAGE_ID=
# META_PAGE_ACCESS_TOKEN=
