# Nomes do processo Iris. Copie para iris-app/.env e troque o que for seu.
# O arquivo fica fora do git. O Compose não lê este arquivo.
#
# O env do container se cria na raiz: cp ../.env.docker.example ../.env.docker
# Os nomes são os mesmos, inclusive os ajustes opcionais no fim.
# No host público, troque a URL para https e o e-mail para resend.
#
# Cada secret: openssl rand -hex 32
# Não commite valor real.

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
PORT=8792
HOST=0.0.0.0
# Produção: NODE_ENV=production. O host pode injetar PORT.
# Banco relativo a iris-app/. No volume: /app/data/iris.db
# O volume é o diretório inteiro: control.db, tenants/ e media/.
IRIS_DB_PATH=./data/iris.db
# IRIS_DB_PATH=/app/data/iris.db

# -----------------------------------------------------------------------------
# Login da UI
# -----------------------------------------------------------------------------
IRIS_ADMIN_EMAIL=you@example.com
# HMAC do cookie. Não autentica MCP/agente e não assina URL de mídia.
IRIS_SESSION_SECRET=change-me-session-secret-min-32-chars
IRIS_OTP_PEPPER=change-me-otp-pepper-min-32-chars
# Bearer só para CLI. A UI usa OTP.
# IRIS_ADMIN_TOKEN=change-me-admin
# Quem pode abrir conta. Omitir no pnpm dev = open.
# Com NODE_ENV=production a variável é obrigatória; sem ela o processo não sobe.
# Produção define allowlist: só este email, se IRIS_ALLOWED_EMAILS estiver vazio.
# open = qualquer email confirmado cria a própria conta.
# allowlist = IRIS_ADMIN_EMAIL e IRIS_ALLOWED_EMAILS. Sem nenhum email, o processo não sobe.
# closed = quem já tem conta entra; conta nova não abre.
# IRIS_TENANT_SIGNUP=allowlist
# IRIS_ALLOWED_EMAILS=you@example.com,other@example.com

# -----------------------------------------------------------------------------
# E-mail
# Dev omite este bloco: SMTP no Mailpit da máquina (127.0.0.1:1025, UI em 8025).
# No .env.docker o host é mailpit, o nome do serviço na rede do Compose.
# Host público: resend. Sem IRIS_CONTACT_EMAIL o formulário da landing responde 503.
# -----------------------------------------------------------------------------
# IRIS_EMAIL_PROVIDER=smtp
# IRIS_SMTP_HOST=127.0.0.1
# IRIS_SMTP_PORT=1025
# IRIS_EMAIL_PROVIDER=resend
# IRIS_FROM_EMAIL=you@example.com
# RESEND_API_KEY=re_...
# IRIS_CONTACT_EMAIL=contact@example.com

# -----------------------------------------------------------------------------
# Criptografia e URL pública
# -----------------------------------------------------------------------------
IRIS_TOKEN_ENCRYPTION_KEY=64-char-hex-or-passphrase
# Local: http://127.0.0.1:8792. Produção: https://seu-dominio, sem barra no final.
IRIS_PUBLIC_BASE_URL=http://127.0.0.1:8792
# HMAC de /publish/media e /upload/assets. Distinto do session secret.
# Obrigatório para publicar no Instagram. Gere com openssl rand -hex 32.
IRIS_PUBLISH_URL_SECRET=change-me-publish-secret

# -----------------------------------------------------------------------------
# Meta / Instagram
# Guia: docs/configuracao/README.md
# Instagram App ID é o de Business login settings, não o de Configurações → Básico.
# META_APP_ID e META_APP_SECRET são o app básico: HMAC do webhook e OAuth da Página.
# -----------------------------------------------------------------------------
# META_INSTAGRAM_APP_ID=
# META_INSTAGRAM_APP_SECRET=
# META_APP_ID=
# META_APP_SECRET=
# META_OAUTH_REDIRECT_URI=http://127.0.0.1:8792/auth/meta/callback
# Produção: https://seu-dominio/auth/meta/callback
# META_WEBHOOK_VERIFY_TOKEN=
# META_GRAPH_API_VERSION=v21.0
# DMs: docs/configuracao/06-mensagens-receptor-primario.md e 07-page-access-token.md
# META_PAGE_ID=
# META_PAGE_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Agente e MCP
# Agente: ../iris-agent/ — o mesmo valor vai em iris.credentials.json
# O código MCP também pode nascer em Configurações. Sem variável, o dev aceita
# dev-mcp-connection-code-change-me. Produção não aceita esse fallback.
# -----------------------------------------------------------------------------
IRIS_AGENT_TOKEN=change-me-agent
IRIS_MCP_CONNECTION_CODE=change-me-mcp-connection

# -----------------------------------------------------------------------------
# Dev (Vite) — o build estático de produção ignora o allowed hosts
# -----------------------------------------------------------------------------
# * = qualquer host. Omitir = só localhost.
VITE_ALLOWED_HOSTS=.ngrok-free.app,.ngrok.io,.trycloudflare.com
# Umami só entra no bundle se as duas existirem na hora do build (ARG do Dockerfile).
# Colocar no painel em runtime não altera o JavaScript já compilado.
# VITE_UMAMI_WEBSITE_ID=
# VITE_UMAMI_SCRIPT_URL=

# -----------------------------------------------------------------------------
# Ajustes opcionais — o código já tem default
# A chave do modelo fica na conta: Configurações → Provedor de IA.
# -----------------------------------------------------------------------------
# IRIS_REPLY_MAX_CONCURRENT=10
# IRIS_RETENTION_DAYS=90
# IRIS_RETENTION_TICK_MS=86400000
# IRIS_PUBLISH_TICK_MS=60000
# IRIS_UPLOAD_MAX_BYTES=15728640
# IRIS_IMAGE_MAX_LONG_EDGE=1080
# IRIS_JPEG_QUALITY=85
# IRIS_IMAGE_MAX_BYTES=1572864
# IRIS_SESSION_MAX_AGE_SEC=86400
# IRIS_OTP_TTL_MINUTES=15
# IRIS_SMTP_SECURE=true
# IRIS_SMTP_USER=
# IRIS_SMTP_PASS=
# Origens extras do CORS, além de localhost. Separadas por vírgula.
# IRIS_CORS_ORIGINS=https://seu-dominio
