# Server
PORT=8792
HOST=0.0.0.0
IRIS_DB_PATH=./data/iris.db

# Auth
IRIS_AGENT_TOKEN=change-me-agent
# IRIS_ADMIN_TOKEN=change-me-admin  # opcional — CLI/scripts; UI usa OTP
IRIS_ADMIN_EMAIL=you@example.com
IRIS_SESSION_SECRET=change-me-session-secret-min-32-chars
IRIS_OTP_PEPPER=change-me-otp-pepper-min-32-chars
# Dev: smtp + Mailpit (portas 1025 / 8025) — default quando NODE_ENV != production
# IRIS_EMAIL_PROVIDER=smtp
# IRIS_SMTP_HOST=127.0.0.1
# IRIS_SMTP_PORT=1025
# Prod: resend
# IRIS_EMAIL_PROVIDER=resend
# IRIS_FROM_EMAIL=you@example.com
# RESEND_API_KEY=re_...
# Agente: ver ../iris-agent/ (kit Meridian portável)

# LLM auto-reply (v1-S6+)
# LLM_API_KEY=
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini
# IRIS_REPLY_TICK_MS=60000
# IRIS_REPLY_TONE=amigável e profissional

# Meta / Instagram — Instagram Login (sem Página do Facebook)
# Use o Instagram App ID/Secret (NÃO o App ID de Configurações → Básico):
# Dashboard → Instagram → API setup with Instagram login → Business login settings
# META_INSTAGRAM_APP_ID=
# META_INSTAGRAM_APP_SECRET=
# Legado (mesmos valores Instagram, se preferir um nome só):
# META_APP_ID=
# META_APP_SECRET=
# IRIS_UPLOAD_MAX_BYTES=15728640
# IRIS_IMAGE_MAX_LONG_EDGE=1080
# IRIS_JPEG_QUALITY=85
# IRIS_IMAGE_MAX_BYTES=1572864
# IRIS_TOKEN_ENCRYPTION_KEY=64-char-hex-or-passphrase
# IRIS_PUBLIC_BASE_URL=https://your-public-host
# IRIS_PUBLISH_URL_SECRET=change-me-publish-secret
# IRIS_PUBLISH_TICK_MS=60000
# META_GRAPH_API_VERSION=v21.0
# META_IG_USER_ID=
# META_APP_ID=
# META_APP_SECRET=
# META_OAUTH_REDIRECT_URI=https://your-public-host/auth/meta/callback
# META_WEBHOOK_VERIFY_TOKEN=
# META_ACCESS_TOKEN=
